# Copy to .env.local (development) or set in your hosting dashboard (production).

# Backend API base URL, no trailing slash. REQUIRED in production.
NEXT_PUBLIC_API_URL=https://api.example.com

# Public site URL used for share links and metadata.
NEXT_PUBLIC_SITE_URL=https://hepi.in

# Where to send users who are not logged in (Sharing Happiness login page).
NEXT_PUBLIC_LOGIN_URL=https://example.com/login

# Allow mock data in production when no API is set (demo deployments only).
# NEXT_PUBLIC_ENABLE_MOCKS=true
